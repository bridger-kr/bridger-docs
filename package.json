{
  "name": "@datari/docs",
  "private": true,
  "version": "0.1.0",
  "description": "DATA BRIDGE documentation site.",
  "scripts": {
    "dev": "mintlify dev --port 3334",
    "build": "mintlify export --output dist/export.zip",
    "build:content": "node scripts/build-presets.mjs && node scripts/build-api-reference.mjs",
    "preview": "mintlify dev --port 3334",
    "test": "node --test scripts/*.test.mjs",
    "lint": "mintlify broken-links",
    "presets": "node scripts/build-presets.mjs",
    "openapi": "node scripts/build-api-reference.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "extract-zip": "^2.0.1",
    "mintlify": "^4.0.0",
    "yaml": "^2.6.0"
  }
}
