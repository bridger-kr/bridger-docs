{
  "name": "@bridger/docs",
  "private": true,
  "version": "0.1.0",
  "description": "Bridger documentation site.",
  "scripts": {
    "dev": "mintlify dev --port 3334",
    "build:content": "node scripts/build-facts.mjs && node scripts/build-presets.mjs && node scripts/build-api-reference.mjs",
    "preview": "mintlify dev --port 3334",
    "lint": "mintlify broken-links",
    "check:content": "node scripts/check-content.mjs",
    "verify:examples": "node scripts/verify-examples.mjs",
    "check": "npm run lint && npm run check:content && npm run verify:examples",
    "presets": "node scripts/build-presets.mjs",
    "openapi": "node scripts/build-api-reference.mjs",
    "facts": "node scripts/build-facts.mjs",
    "test:dependency-security": "node --test tests/dependency-security.test.cjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "mintlify": "4.2.942",
    "yaml": "^2.6.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "adm-zip": "0.6.1",
    "axios": "1.20.0",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "sharp": "0.35.5",
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "qs": "6.16.0",
    "postcss-selector-parser": "7.1.6",
    "katex": "0.18.2",
    "braces": "npm:@bleedingdev/braces@3.0.4"
  }
}
